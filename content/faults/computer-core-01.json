    {
      "id": "core-scheduler",
      "type": "ds-trace",
      "course": "veri-yapilari",
      "topic": "yigin-kuyruk-bagli-liste",
      "title": "Çekirdek görev zamanlayıcısı",
      "briefing": "Yığın (Stack) son giren ilk çıkar: Push tepeye koyar, Pop tepeden alır, Peek bakar ama almaz. Kuyruk (Queue) ilk giren ilk çıkar: Enqueue sona ekler, Dequeue baştan alır. LinkedList'te AddFirst/AddLast uçlara ekler, AddAfter(Find(v), x) ilk v'nin hemen arkasına ekler, Remove(v) ilk v'yi siler. Zamanlayıcının izleme kaydında tek satır bozuk: o adımı bul ve doğru durumu yaz.",
      "config": {
        "ops": [
          8,
          18
        ],
        "lines": [
          15,
          25
        ],
        "structures": [
          "stack",
          "queue",
          "list"
        ],
        "corruptions": [
          "order_confusion",
          "skip_effect",
          "off_by_one",
          "wrong_end"
        ],
        "hideCounters": false,
        "templates": [
          {
            "id": "stack-to-queue",
            "story": "Görevler önce yığına itilir; çift numaralılar sırayla kuyruğa aktarılır.",
            "structures": [
              {
                "name": "s",
                "kind": "stack"
              },
              {
                "name": "q",
                "kind": "queue"
              }
            ],
            "params": {
              "N": [
                4,
                5,
                6
              ],
              "K": [
                2,
                3,
                5
              ],
              "M": [
                1,
                2
              ]
            },
            "body": [
              {
                "for": "i",
                "from": "1",
                "to": "N",
                "body": [
                  {
                    "call": "Push",
                    "on": "s",
                    "arg": "i*K"
                  }
                ]
              },
              {
                "while": {
                  "count": "s",
                  "op": ">",
                  "value": "M"
                },
                "body": [
                  {
                    "call": "Pop",
                    "on": "s",
                    "into": "x"
                  },
                  {
                    "if": {
                      "var": "x",
                      "mod": 2,
                      "eq": 0
                    },
                    "then": [
                      {
                        "call": "Enqueue",
                        "on": "q",
                        "arg": "x"
                      }
                    ]
                  }
                ]
              },
              {
                "call": "Dequeue",
                "on": "q",
                "into": "y"
              },
              {
                "call": "Push",
                "on": "s",
                "arg": "y+1"
              }
            ]
          },
